# All optional. Copy to .env.local for local development; never commit real values.

# Public origin, used for canonical URLs in the built pages.
SITE_URL=http://localhost:3000

# Build against a different snapshot than data/snapshot.json (CI uses tests/fixtures/snapshot.json).
# DATA_SNAPSHOT=tests/fixtures/snapshot.json

# Ingestion: raises the NVD rate limit from 5 to 50 requests / 30 s. In CI, store it as a GitHub Actions secret.
NVD_API_KEY=
