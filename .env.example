# Copy to .env.local for local development. Never commit real values.

# --- Read side (Next.js app) ---
# Supabase project URL and the *anon* key (read-only; RLS allows SELECT only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Optional: render from a local JSON snapshot instead of Supabase
# (produced by `npm run ingest -- --no-db --out data/snapshot.json`).
# DATA_SNAPSHOT=data/snapshot.json

# --- Write side (ingestion, GitHub Actions only) ---
# Service role key bypasses RLS. Store it ONLY in GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: raises NVD rate limit from 5 to 50 requests / 30 s.
NVD_API_KEY=
